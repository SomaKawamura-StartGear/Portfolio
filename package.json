{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:pages": "npm run build && echo 'Build completed for Cloudflare Pages'",
    "build:client": "swc src -d dist/client --config-file .swcrc",
    "build:server": "swc server -d dist/server --config-file .swcrc.server",
    "build:all": "npm run build:client && npm run build:server",
    "server": "node dist/server/index.js",
    "dev:server": "nodemon --watch server --ext js --exec \"npm run build:server && npm run server\"",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "start:ssr": "vite-plugin-ssr start",
    "build:ssr": "vite build",
    "build:production": "npm run build:all && npm run build:ssr",
    "start:production": "npm run build:production && npm run server",
    "ssr:server": "node dist/server/ssr-server.js",
    "dev:ssr": "nodemon --watch server --ext js --exec \"npm run build:server && npm run ssr:server\"",
    "start:ssr-full": "npm run build:production && npm run ssr:server"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite-plugin-ssr": "^0.4.142"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.3.100",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "nodemon": "^3.0.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  }
}
